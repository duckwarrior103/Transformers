#!/bin/bash

#SBATCH --partition=gpuA
#SBATCH --gpus=2
#SBATCH -c 8
#SBATCH --ntasks=1
#SBATCH --time=0-1
#SBATCH --output=/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/sort_jobs/smoke-test/smoke_test_%j.out

# Smoke test: run all 6 model types at small-medium scale (~15 min total).
# Purpose: validate that code paths, CSV logging, and plots all work correctly
# before committing GPU time to a full experiment.
#
# Parameters: seq=32, vocab=64, epochs=3, train_examples=2000
# Pass: all 6 CSVs written with 3 rows each, comparison plot generated.

set -e

module load apps/binapps/conda/miniforge3/25.9.1
module load libs/cuda/12.4.1
module load apps/binapps/pytorch/2.6.0-312-gpu-cu124
source /mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/.venv/bin/activate

BASE="/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers"
export PYTHONPATH="$BASE/.venv/lib/python3.12/site-packages:$BASE:$PYTHONPATH"
RUN_ID="run_$(date +%Y%m%dT%H%M%S)"
RUN_DIR="$BASE/results/sort_jobs/smoke-test/$RUN_ID"
mkdir -p "$RUN_DIR/data"
exec > >(tee -a "$RUN_DIR/output.log") 2>&1

echo "Smoke test run: $RUN_ID"
echo "Results dir:    $RUN_DIR"

MODEL_LIST=(standard linear_attention gla retnet deltanet gated_deltanet)

JOB_IDX=0
declare -a BATCH_PIDS=()

for MODEL in "${MODEL_LIST[@]}"; do
    GPU_ID=$(( JOB_IDX % 2 ))
    echo "===== model=$MODEL (gpu=$GPU_ID) ====="
    OUT_CSV="$RUN_DIR/data/model_${MODEL}.csv"
    CUDA_VISIBLE_DEVICES=$GPU_ID python -u "$BASE/experiments/sort_experiment.py" \
        --model_type "$MODEL" \
        --seq_length 32 \
        --max_value 64 \
        --train_examples 2000 \
        --val_examples 500 \
        --batch_size 64 \
        --epochs 3 \
        --lr 0.0003 \
        --hidden_size 512 \
        --num_layers 6 \
        --num_heads 8 \
        --results_file "$OUT_CSV" &
    BATCH_PIDS+=($!)
    JOB_IDX=$(( JOB_IDX + 1 ))

    if [ ${#BATCH_PIDS[@]} -ge 2 ]; then
        for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done
        BATCH_PIDS=()
    fi
done

for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done

echo "===== All models complete. Generating plots... ====="
python -u "$BASE/results/sort_jobs/sweep-models/plot_model_comparison.py" --run_dir "$RUN_DIR"

echo "===== Smoke test finished. Results in $RUN_DIR ====="
