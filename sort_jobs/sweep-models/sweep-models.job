#!/bin/bash

#SBATCH --partition=gpuA
#SBATCH --gpus=2
#SBATCH -c 8
#SBATCH --ntasks=1
#SBATCH --time=1-0
#SBATCH --output=/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/jobs/sweep-models/sweep_models_%j.out

# Multi-model sweep: compare all attention mechanisms at fixed (seq, vocab).
# Produces model_comparison.png — the primary model ranking plot.
#
# Tweak SEQ_LENGTH, MAX_VALUE, EPOCHS, TRAIN_EXAMPLES below as needed.

set -e

module load apps/binapps/conda/miniforge3/25.9.1
module load libs/cuda/12.4.1
module load apps/binapps/pytorch/2.6.0-312-gpu-cu124
source /mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/.venv/bin/activate

BASE="/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers"
RUN_ID="run_$(date +%Y%m%dT%H%M%S)"
RUN_DIR="$BASE/results/sweep-models/$RUN_ID"
mkdir -p "$RUN_DIR"

# ── Experiment parameters ──────────────────────────────────────────────────
SEQ_LENGTH=64
MAX_VALUE=128
EPOCHS=8
TRAIN_EXAMPLES=50000
VAL_EXAMPLES=10000
BATCH_SIZE=256
LR=0.0003
HIDDEN_SIZE=512
NUM_LAYERS=6
NUM_HEADS=8
# ──────────────────────────────────────────────────────────────────────────

echo "Multi-model sweep run: $RUN_ID"
echo "Parameters: seq=$SEQ_LENGTH max_value=$MAX_VALUE epochs=$EPOCHS"
echo "Results dir: $RUN_DIR"

MODEL_LIST=(standard linear_attention gla retnet deltanet gated_deltanet)

JOB_IDX=0
declare -a BATCH_PIDS=()

for MODEL in "${MODEL_LIST[@]}"; do
    GPU_ID=$(( JOB_IDX % 2 ))
    echo "===== model=$MODEL (gpu=$GPU_ID) ====="
    OUT_CSV="$RUN_DIR/model_${MODEL}.csv"
    CUDA_VISIBLE_DEVICES=$GPU_ID python -u "$BASE/experiments/sort_experiment.py" \
        --model_type "$MODEL" \
        --seq_length "$SEQ_LENGTH" \
        --max_value "$MAX_VALUE" \
        --train_examples "$TRAIN_EXAMPLES" \
        --val_examples "$VAL_EXAMPLES" \
        --batch_size "$BATCH_SIZE" \
        --epochs "$EPOCHS" \
        --lr "$LR" \
        --hidden_size "$HIDDEN_SIZE" \
        --num_layers "$NUM_LAYERS" \
        --num_heads "$NUM_HEADS" \
        --results_file "$OUT_CSV" &
    BATCH_PIDS+=($!)
    JOB_IDX=$(( JOB_IDX + 1 ))

    if [ ${#BATCH_PIDS[@]} -ge 2 ]; then
        for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done
        BATCH_PIDS=()
    fi
done

for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done

echo "===== All models complete. Generating comparison plots... ====="
python -u "$BASE/results/sweep-models/plot_model_comparison.py" --run_dir "$RUN_DIR"

echo "===== Sweep-models finished. Results in $RUN_DIR ====="
