#!/bin/bash

#SBATCH --partition=gpuA
#SBATCH --gpus=2
#SBATCH -c 8
#SBATCH --ntasks=1
#SBATCH --time=1-0
#SBATCH --output=/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/sort_jobs/sweep-seq-length/sweep_seq_%j.out

set -e

module load apps/binapps/conda/miniforge3/25.9.1
module load libs/cuda/12.4.1
module load apps/binapps/pytorch/2.6.0-312-gpu-cu124
source /mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/.venv/bin/activate

BASE="/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers"
export PYTHONPATH="$BASE/.venv/lib/python3.12/site-packages:$BASE:$PYTHONPATH"
RUN_ID="run_$(date +%Y%m%dT%H%M%S)"
RUN_DIR="$BASE/results/sort_jobs/sweep-seq-length/$RUN_ID"
mkdir -p "$RUN_DIR/data"
exec > >(tee -a "$RUN_DIR/output.log") 2>&1

JOB_IDX=0
declare -a BATCH_PIDS=()

for SEQ in 2 4 8 16 32 64 128 256 512 1024; do
    GPU_ID=$(( JOB_IDX % 2 ))
    echo "===== seq_length=$SEQ (gpu=$GPU_ID) ====="
    CUDA_VISIBLE_DEVICES=$GPU_ID python -u "$BASE/experiments/sort_experiment.py" \
        --seq_length $SEQ \
        --max_value 1024 \
        --train_examples 50000 \
        --val_examples 5000 \
        --batch_size 256 \
        --epochs 8 \
        --lr 0.0003 \
        --hidden_size 512 \
        --num_layers 6 \
        --num_heads 8 \
        --results_file "$RESULTS_DIR/data/seq_${SEQ}.csv" &
    BATCH_PIDS+=($!)
    JOB_IDX=$(( JOB_IDX + 1 ))

    if [ ${#BATCH_PIDS[@]} -ge 2 ]; then
        for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done
        BATCH_PIDS=()
    fi
done

for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done

echo "All sequence length sweeps completed."