#!/bin/bash

#SBATCH --partition=gpuA
#SBATCH --gpus=2
#SBATCH -c 8
#SBATCH --ntasks=1
#SBATCH --time=7-0
#SBATCH --output=/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/jobs/sweep-full/sweep_full_%j.out

# Full 3D sweep: all models × all seq_lengths × all max_values.
#
# For each model: produces a (seq_length × vocab_size) heatmap.
# Across models: produces a stacked comparison figure (all heatmaps same scale)
#                and pairwise difference heatmaps.
#
# WARNING: 6 models × 12 seq × 12 vocab = 864 training runs. Very long job.
# Always run jobs/smoke-test first to validate setup.
#
# Directory layout:
#   results/sweep-full/<RUN_ID>/
#     model_standard/seq_16_maxv_64.csv   (one CSV per training run)
#     model_gla/seq_16_maxv_64.csv
#     ...
#   After aggregation (auto-called at end of job):
#     exact_acc_heatmap_standard.png      (per-model heatmap)
#     exact_acc_heatmap_gla.png
#     exact_acc_comparison.png            (all models side-by-side, same colour scale)
#     exact_acc_diff_standard_vs_gla.png  (pairwise difference maps)

set -e

module load apps/binapps/conda/miniforge3/25.9.1
module load libs/cuda/12.4.1
module load apps/binapps/pytorch/2.6.0-312-gpu-cu124
source /mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/.venv/bin/activate

BASE="/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers"
RUN_ID="run_$(date +%Y%m%dT%H%M%S)"
RUN_DIR="$BASE/results/sweep-full/$RUN_ID"
mkdir -p "$RUN_DIR"

# ── Experiment parameters ──────────────────────────────────────────────────
MODEL_LIST=(standard linear_attention gla retnet deltanet gated_deltanet)
SEQ_LIST=(2 4 8 16 32 64 128 256 512 1024 2048 4096)
MAXV_LIST=(2 4 8 16 32 64 128 256 512 1024 2048 4096)
EPOCHS=8
TRAIN_EXAMPLES=50000
VAL_EXAMPLES=10000
BATCH_SIZE=256
LR=0.0003
HIDDEN_SIZE=512
NUM_LAYERS=6
NUM_HEADS=8
# ──────────────────────────────────────────────────────────────────────────

TOTAL=$(( ${#MODEL_LIST[@]} * ${#SEQ_LIST[@]} * ${#MAXV_LIST[@]} ))
COUNT=0

echo "Full 3D sweep: $TOTAL runs"
echo "  models:      ${MODEL_LIST[*]}"
echo "  seq_lengths: ${SEQ_LIST[*]}"
echo "  max_values:  ${MAXV_LIST[*]}"
echo "  results dir: $RUN_DIR"

JOB_IDX=0
declare -a BATCH_PIDS=()

for MODEL in "${MODEL_LIST[@]}"; do
    MODEL_DIR="$RUN_DIR/model_${MODEL}"
    mkdir -p "$MODEL_DIR"
    echo "========== model=$MODEL =========="

    for SEQ in "${SEQ_LIST[@]}"; do
        for MAXV in "${MAXV_LIST[@]}"; do
            COUNT=$(( COUNT + 1 ))
            GPU_ID=$(( JOB_IDX % 2 ))
            OUT_CSV="$MODEL_DIR/seq_${SEQ}_maxv_${MAXV}.csv"
            echo "  [$COUNT/$TOTAL] seq=$SEQ max_value=$MAXV gpu=$GPU_ID -> $OUT_CSV"
            CUDA_VISIBLE_DEVICES=$GPU_ID python -u "$BASE/experiments/sort_experiment.py" \
                --model_type "$MODEL" \
                --seq_length  "$SEQ" \
                --max_value   "$MAXV" \
                --train_examples "$TRAIN_EXAMPLES" \
                --val_examples   "$VAL_EXAMPLES" \
                --batch_size  "$BATCH_SIZE" \
                --epochs      "$EPOCHS" \
                --lr          "$LR" \
                --hidden_size "$HIDDEN_SIZE" \
                --num_layers  "$NUM_LAYERS" \
                --num_heads   "$NUM_HEADS" \
                --results_file "$OUT_CSV" &
            BATCH_PIDS+=($!)
            JOB_IDX=$(( JOB_IDX + 1 ))

            if [ ${#BATCH_PIDS[@]} -ge 2 ]; then
                for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done
                BATCH_PIDS=()
            fi
        done
    done
done

for pid in "${BATCH_PIDS[@]}"; do wait "$pid" || true; done

echo "===== All runs complete. Generating plots... ====="
python -u "$BASE/results/sweep-full/aggregate_full.py" --run_dir "$RUN_DIR"

echo "===== Sweep-full done. Results in $RUN_DIR ====="
