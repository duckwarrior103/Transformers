#!/bin/bash

#SBATCH --partition=gpuA
#SBATCH --gpus=2
#SBATCH -c 8
#SBATCH --ntasks=1
#SBATCH --time=3-0
#SBATCH --output=/dev/null

set -e

module load apps/binapps/conda/miniforge3/25.9.1
module load libs/cuda/12.4.1
module load apps/binapps/pytorch/2.6.0-312-gpu-cu124

source /mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers/.venv/bin/activate

BASE="/mnt/iusers01/fse-ugpgt01/compsci01/j84846ky/scratch/Transformers"
export PYTHONPATH="$BASE/.venv/lib/python3.12/site-packages:$BASE:$PYTHONPATH"

MODELS=(gdn_ek1 gdn_ek2 gdn_ek4 gead_elm64 gead_elm128 gead_elm256 gead_elm64_orth gead_elm128_orth gead_elm256_orth)
LRS=(0.003 0.001 0.0003 0.0001)
NUM_DATA_TOKENS=16

RUN_ID="run_$(date +%Y-%m-%d_%H-%M-%S)"
RUN_DIR="$BASE/results/palindrome_jobs/elm_comparison_lrscan/$RUN_ID"

mkdir -p "$RUN_DIR/logs"
for MODEL in "${MODELS[@]}"; do
    for LR in "${LRS[@]}"; do
        mkdir -p "$RUN_DIR/data/$MODEL/lr_$LR"
    done
done
exec > >(tee -a "$RUN_DIR/logs/output.log") 2>&1

declare -a RUNNING_PIDS=()
declare -a FREE_GPUS=(0 1)
declare -A PID_TO_GPU=()

for MODEL in "${MODELS[@]}"; do
    for LR in "${LRS[@]}"; do
        for SEQ in 2 4 8 16 32 64 128 256 512; do
            while [ ${#FREE_GPUS[@]} -eq 0 ]; do
                wait -n || true
                new_running_pids=()
                for pid in "${RUNNING_PIDS[@]}"; do
                    if kill -0 "$pid" 2>/dev/null; then
                        new_running_pids+=("$pid")
                    else
                        gpu_id="${PID_TO_GPU[$pid]}"
                        FREE_GPUS+=("$gpu_id")
                        unset PID_TO_GPU["$pid"]
                    fi
                done
                RUNNING_PIDS=("${new_running_pids[@]}")
            done

            last=$(( ${#FREE_GPUS[@]} - 1 ))
            GPU_ID="${FREE_GPUS[$last]}"
            unset 'FREE_GPUS[$last]'

            echo "===== model=$MODEL lr=$LR seq_length=$SEQ (gpu=$GPU_ID) ====="
            CUDA_VISIBLE_DEVICES=$GPU_ID python -u "$BASE/experiments/palindrome_experiment.py" \
                --model_type $MODEL \
                --seq_length $SEQ \
                --num_data_tokens $NUM_DATA_TOKENS \
                --train_examples 50000 \
                --val_examples 5000 \
                --batch_size 256 \
                --epochs 8 \
                --lr $LR \
                --hidden_size 128 \
                --num_layers 2 \
                --num_heads 2 \
                --test_results_file "$RUN_DIR/data/$MODEL/lr_$LR/${MODEL}_test_results_seq_${SEQ}.csv" \
                --results_file "$RUN_DIR/data/$MODEL/lr_$LR/${MODEL}_seq_${SEQ}.csv" \
                > "$RUN_DIR/logs/${MODEL}_lr_${LR}_seq_${SEQ}.log" 2>&1 &

            NEW_PID=$!
            RUNNING_PIDS+=("$NEW_PID")
            PID_TO_GPU["$NEW_PID"]="$GPU_ID"
        done
    done
done

for pid in "${RUNNING_PIDS[@]}"; do wait "$pid" || true; done

echo "All sweeps completed."

for LR in "${LRS[@]}"; do
    MERGED="$RUN_DIR/data/test_results_lr_${LR}.csv"
    first_file=""
    for MODEL in "${MODELS[@]}"; do
        for f in "$RUN_DIR"/data/"$MODEL"/lr_"$LR"/${MODEL}_test_results_seq_*.csv; do
            if [ -f "$f" ]; then
                if [ -z "$first_file" ]; then
                    first_file="$f"
                    head -n 1 "$first_file" > "$MERGED"
                fi
                tail -n +2 "$f" >> "$MERGED"
            fi
        done
    done
    echo "Merged test results (lr=$LR) -> $MERGED"
done

echo "Plotting LR scan graphs"
python -u "$BASE/results/palindrome_jobs/elm_comparison/plot_lrscan.py" "$RUN_DIR"
echo "Finished"
